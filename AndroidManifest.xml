<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.apptimer.app">

    <!-- REQUIRED PERMISSIONS -->
    <!-- 1. PACKAGE_USAGE_STATS: System permission to read app usage history via UsageStatsManager -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 2. POST_NOTIFICATIONS: Android 13+ (API 33+) permission for 80%, 90%, 100% threshold alarms -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 3. QUERY_ALL_PACKAGES: To enumerate installed apps eligible for screen time limits -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 4. INTERNET & ACCESS_NETWORK_STATE: Required by Google Mobile Ads (AdMob) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 5. RECEIVE_BOOT_COMPLETED: Re-registers WorkManager quota checks on device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTimer">

        <!-- GOOGLE ADMOB APP ID CONFIGURATION -->
        <!-- DEVELOPMENT: Official Google AdMob Sample App ID -->
        <!-- PRODUCTION: Replace ca-app-pub-3940256099942544~3347511713 with your real App ID from AdMob Console -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge" />
    </application>
</manifest>